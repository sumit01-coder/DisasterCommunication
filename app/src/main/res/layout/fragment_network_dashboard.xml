<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1E"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NETWORK INTELLIGENCE"
        android:textColor="#3B82F6"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvHealthSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Real-time mesh network analysis"
        android:textColor="#88AABB"
        android:textSize="12sp"
        android:layout_marginBottom="16dp"/>

    <!-- Health Score Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#1A2333"
        app:cardCornerRadius="16dp"
        app:strokeColor="#3B82F6"
        app:strokeWidth="1dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Network Health"
                    android:textColor="#88AABB"
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/tvHealthScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#4CAF50"
                    android:textSize="42sp"
                    android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">
                <TextView
                    android:id="@+id/tvDeviceCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Devices"
                    android:textColor="#CCDDEE"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvRouteCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Routes"
                    android:textColor="#88AABB"
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/tvRelayCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Relays"
                    android:textColor="#88AABB"
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/tvHardwareNodes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Hardware Hubs"
                    android:textColor="#00E5FF"
                    android:textStyle="bold"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Critical Nodes -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#1A2333"
        app:cardCornerRadius="12dp"
        app:strokeColor="#FF8800"
        app:strokeWidth="1dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Critical Nodes"
                android:textColor="#FF8800"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
            <TextView
                android:id="@+id/tvCriticalNodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calculating..."
                android:textColor="#CCDDEE"
                android:textSize="13sp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Dead Zones -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#1A2333"
        app:cardCornerRadius="12dp"
        app:strokeColor="#FF4444"
        app:strokeWidth="1dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dead Zones"
                android:textColor="#FF4444"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
            <TextView
                android:id="@+id/tvDeadZones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No dead zones detected"
                android:textColor="#CCDDEE"
                android:textSize="13sp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- LoRa Relay Recommendations -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#1A2333"
        app:cardCornerRadius="12dp"
        app:strokeColor="#9C27B0"
        app:strokeWidth="1dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LoRa Relay Recommendations"
                android:textColor="#9C27B0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
            <TextView
                android:id="@+id/tvLoraRec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No recommendations yet"
                android:textColor="#CCDDEE"
                android:textSize="13sp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Black Box Log -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Event Log (Black Box)"
        android:textColor="#CCDDEE"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="#101520"
        app:cardCornerRadius="12dp">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/tvBlackBoxLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Waiting for events..."
                android:textColor="#44FFAA"
                android:textSize="11sp"
                android:fontFamily="monospace"/>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
