<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- OpenStreetMap View (Full Screen Background) -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Status Cards Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="top"
        android:clipToPadding="false"
        android:padding="16dp">

        <!-- Top Status Bar (Mesh Range) - Floating -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTopStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_wifi"
                    app:tint="@color/primary"/>
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    
                    <TextView
                        android:id="@+id/tvNetworkStatusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Offline Mode · Mesh Active"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                        
                    <TextView
                        android:id="@+id/tvNetworkStatusDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12 nearby devices · ~500 m"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"/>
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivNetworkSignal"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_signal"
                    app:tint="@color/success"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

        <!-- Top Left Status Bar (GPS Accuracy) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGpsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/surface">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">
            
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_mylocation"
                app:tint="@color/primary"/>
                
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS Accuracy"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                    
                <TextView
                    android:id="@+id/tvGpsAccuracy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="±5m"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>
            
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:orientation="vertical"
                android:gravity="end">
                
                <TextView
                    android:id="@+id/tvGpsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Excellent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/success"/>
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open sky"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>
        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Map Floating Actions (Right Side) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="110dp"
        android:gravity="center_horizontal">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnCenterLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_mylocation"
            app:fabSize="normal"
            app:tint="@color/text_primary"
            app:backgroundTint="@color/surface"
            app:elevation="4dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            android:contentDescription="My Location"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnLayers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_mapmode"
            app:fabSize="normal"
            app:tint="@color/text_primary"
            app:backgroundTint="@color/surface"
            app:elevation="4dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            android:contentDescription="Map Layers"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnReport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_dialog_alert"
            app:fabSize="normal"
            app:tint="@color/white"
            app:backgroundTint="@color/error"
            app:elevation="4dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            android:contentDescription="Report Emergency"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabSosMap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_sos"
            app:fabCustomSize="64dp"
            app:maxImageSize="32dp"
            app:tint="@color/white"
            app:backgroundTint="@color/error"
            app:elevation="8dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            android:contentDescription="Emergency SOS"
            android:layout_marginBottom="16dp"/>
    </LinearLayout>

    <!-- Map Legend (Bottom Left) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMapLegend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="110dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/surface">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="🔵" android:textSize="14sp" android:gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="You" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_marginStart="8dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="👤" android:textSize="14sp" android:gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nearby Users" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_marginStart="8dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="🟩" android:textSize="14sp" android:gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Safe Zone" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_marginStart="8dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="⚠️" android:textSize="14sp" android:gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Danger Zone" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_marginStart="8dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="➖" android:textSize="14sp" android:gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Evacuation Route" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_marginStart="8dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="🏥" android:textSize="14sp" android:gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hospital" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Sheet: Layers -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/bottomSheetLayers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/surface_dim"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Map Layers"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swNearbyUsers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nearby Users"
                android:checked="true"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swMeshNetwork"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mesh Network Coverage"
                android:checked="true"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swSafeZones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Safe Zones"
                android:checked="true"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swDangerZones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Danger Zones"
                android:checked="true"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swShelters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Emergency Shelters"
                android:checked="true"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swHospitals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hospitals"
                android:checked="true"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swEvacuationRoutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Evacuation Routes"
                android:checked="true"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownloadOffline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Download Offline Map (10km)"
                app:icon="@android:drawable/stat_sys_download"
                app:iconGravity="textStart"
                style="@style/Widget.MaterialComponents.Button"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Sheet: Marker Detail -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/bottomSheetMarkerDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/surface_dim"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <TextView
                    android:id="@+id/tvMarkerIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏥"
                    android:textSize="24sp"/>
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">
                    
                    <TextView
                        android:id="@+id/tvMarkerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Medical Support"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                        
                    <TextView
                        android:id="@+id/tvMarkerSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="250 m away"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                android:background="@color/surface_variant"
                android:gravity="center_vertical">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status:"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                    
                <TextView
                    android:id="@+id/tvMarkerStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Available"
                    android:textColor="@color/success"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Signal:"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginStart="16dp"/>
                    
                <TextView
                    android:id="@+id/tvMarkerSignal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Strong"
                    android:textColor="@color/success"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp">
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMarkerRoute"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Get Route"
                    app:icon="@android:drawable/ic_menu_directions"
                    style="@style/Widget.MaterialComponents.Button"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMarkerShare"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Share"
                    app:icon="@android:drawable/ic_menu_share"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Sheet: Report Emergency -->
    <include layout="@layout/bottom_sheet_report" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
